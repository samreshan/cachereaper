{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cachereaper",
  "version": "1.6.1",
  "identifier": "io.github.samreshan.cachereaper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cachereaper",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/samreshan/cachereaper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEOERENUJGMjkzRDAzOTcKUldTWEF6MHB2OVdOL2ZqVjJpT1lCelVMOHh0c2ViREhGQmhCcFhFOXBzVU5zRm9HNmFBYnl2bVIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Treemap disk visualiser that knows what is safe to delete",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
