{
  "schema": 2,
  "version": "1.6.1",
  "tiers": [
    "low",
    "medium",
    "high"
  ],
  "forbidden_parts": [
    ".git",
    ".gnupg",
    ".hg",
    ".ssh",
    ".svn",
    "CloudStorage",
    "Keychains",
    "Mobile Documents",
    "Photos Library.photoslibrary"
  ],
  "cloud_dir_hints": [
    "onedrive",
    "google drive",
    "dropbox",
    "icloud",
    "creative cloud",
    "pcloud",
    "mega",
    "megasync",
    "sync.com",
    "box sync",
    "nextcloud"
  ],
  "skip_top_level": [
    ".Trash",
    "AppData",
    "Applications",
    "Library",
    "Movies",
    "Music",
    "Pictures",
    "Public",
    "Virtual Machines.localized"
  ],
  "static": [
    {
      "id": "npm-npx",
      "tier": "low",
      "glob": ".npm/_npx",
      "label": "npx one-off package downloads",
      "regen": "re-downloaded on next npx",
      "children": false,
      "warn": "",
      "system": false,
      "os": "any"
    },
    {
      "id": "npm-cache",
      "tier": "low",
      "glob": ".npm/_cacache",
